---
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="https://www.w3.org/2005/Atom" xml:lang="en">
<title type="text">{cdi:settings.title}</title>
<generator uri="https://iamroq.dev/">Roq</generator>
<link rel="self" type="application/atom+xml" href="{site.url.absolute}feed.xml" />
<link rel="alternate" type="text/html" href="{site.url.absolute}" />
<updated>{site.posts.get(0).date.format("yyyy-MM-dd'T'HH:mm:ssXXX")}</updated>
<id>{site.url.absolute}</id>
<author>
  <name>{cdi:settings.owner.name}</name>
  <uri>{site.url.absolute}</uri>
  {#if cdi:settings.owner.email??}<email>{cdi:settings.owner.email}</email>{/if}
</author>
{#for post in site.posts.take(20)}
    {#if !post.data.hidden??}
        {#let author=(cdi:authors.get(post.data.author) ?: cdi:settings.owner)}
        <entry>
          <title type="html"><![CDATA[{post.title.raw}]]></title>
          <link rel="alternate" type="text/html" href="{post.url.absolute}" />
          <id>{post.url.absolute}</id>
          {#if post.data.modified??}<updated>{post.data.modified}</updated>
          <published>{post.date.format("yyyy-MM-dd'T'HH:mm:ssXXX")}</published>
          {#else}<published>{post.date.format("yyyy-MM-dd'T'HH:mm:ssXXX")}</published>
          <updated>{post.date.format("yyyy-MM-dd'T'HH:mm:ssXXX")}</updated>{/if}
          <author>
            <name>{author.name}</name>
            <uri>{site.url.absolute}</uri>
            {#if author.email??}<email>{author.email}</email>{/if}
          </author>
          <content type="html">{post.content}
          &lt;p&gt;&lt;a href=&quot;{post.url.absolute}&quot;&gt;{post.title}&lt;/a&gt; was originally published by {author.name} at &lt;a href=&quot;{site.url.absolute}&quot;&gt;{cdi:settings.title}&lt;/a&gt; on {post.date.format('MMMM dd, yyyy')}.&lt;/p&gt;</content>
        </entry>
        {/let}
    {/if}
{/for}
</feed>
